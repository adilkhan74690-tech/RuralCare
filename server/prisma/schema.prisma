// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CHW") // Community Health Worker, Supervisor, Admin
  villageZone  String
  phoneNumber  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Patient {
  id               String     @id @default(uuid())
  patientId        String     @unique // Fictional display ID e.g. "RC-2026-001"
  fullName         String
  age              Int
  gender           String     // Female, Male, Other
  village          String
  contactNumber    String
  chwAssigned      String
  registrationDate DateTime   @default(now())
  notes            String?
  syncStatus       String     @default("synced") // synced, pending, failed, conflict
  version          Int        @default(1)
  lastModified     DateTime   @updatedAt
  createdAt        DateTime   @default(now())

  followUps        FollowUp[]
  tasks            Task[]
  emergencyIncidents EmergencyIncident[]

  @@map("patients")
}

model FollowUp {
  id               String    @id @default(uuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientDisplayId String
  patientName      String
  visitDate        DateTime
  category         String    // General check-up, Maternal health follow-up, etc.
  observations     String    // General administrative observations
  notes            String
  nextFollowUpDate DateTime?
  status           String    @default("scheduled") // scheduled, completed, missed, cancelled
  chwName          String
  syncStatus       String    @default("synced")
  version          Int       @default(1)
  lastModified     DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  @@map("follow_ups")
}

model Task {
  id           String    @id @default(uuid())
  title        String
  patientId    String?
  patient      Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName  String?
  dueDate      DateTime
  priority     String    @default("medium") // low, medium, high, urgent
  completed    Boolean   @default(false)
  completedAt  DateTime?
  assignedChw  String
  category     String    // Administrative, Routine follow-up, etc.
  syncStatus   String    @default("synced")
  version      Int       @default(1)
  lastModified DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@map("tasks")
}

model SyncAuditLog {
  id              String    @id @default(uuid())
  entityType      String    // patient, followup, task
  entityId        String
  operationType   String    // CREATE, UPDATE, DELETE
  payload         Json
  status          String    @default("synced")
  clientTimestamp DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  @@map("sync_audit_logs")
}

model EmergencyIncident {
  id                      String    @id @default(uuid())
  incidentCode            String    @unique // e.g. "EMG-2026-001"
  patientId               String?
  patient                 Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientDisplayId        String?
  patientName             String
  isUnregistered          Boolean   @default(false)
  unregisteredPatientAge  Int?
  unregisteredGender      String?
  ashaWorkerId            String
  ashaWorkerName          String
  incidentTimestamp       DateTime  @default(now())
  
  // GPS & Location tracking
  workerLatitude          Float?
  workerLongitude         Float?
  patientLatitude         Float?
  patientLongitude        Float?
  locationType            String    @default("same_as_worker") // "same_as_worker" | "different"
  manualAddress           String?
  village                 String?
  landmark                String?
  
  // Clinical / Emergency Details
  category                String    // "Maternal / Obstetric", "Severe Trauma", etc.
  priority                String    @default("urgent") // "urgent", "critical", "high"
  chiefComplaints         String?
  notes                   String    @default("")
  
  // Phase 3 Referral Workflow
  referralStatus          String    @default("initiated") // initiated, facility_selected, transport_arranged, in_transit, arrived, completed, cancelled
  facilityId              String?
  facilityName            String?
  facilityType            String?   // PHC, CHC, District Hospital, Private
  facilityPhone           String?
  facilityAddress         String?
  facilityDistanceKm      Float?
  
  contactAttempts         Json?     // Array of contact attempts: [{ timestamp, recipient, outcome, notes }]
  transportType           String?   // "108 Ambulance", "102 Maternal Ambulance", "Private Vehicle", "PHC Ambulance"
  transportContact        String?
  transportNotes          String?
  dispatchConfirmed       Boolean   @default(false)
  
  arrivedAt               DateTime?
  handoverTo              String?
  handoverNotes           String?
  
  referralCode            String?   // e.g. "REF-2026-94821"
  
  // Sync & Versioning
  syncStatus              String    @default("synced") // synced, pending, failed
  version                 Int       @default(1)
  lastModified            DateTime  @updatedAt
  createdAt               DateTime  @default(now())

  @@map("emergency_incidents")
}
