# ==============================================================================
# RuralCare Connect - Server Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' in the server directory:
#   cp .env.example .env
# Fill in your local database credentials and generate a secure random JWT secret.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
NODE_ENV=development

# Server port
PORT=5000

# PostgreSQL connection string (Replace USER and PASSWORD with your local Postgres credentials)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ruralcare_db?schema=public

# Secret key for signing JSON Web Tokens (use a minimum 32-character random string)
JWT_SECRET=replace_with_a_long_random_secret

# JWT token expiration window
JWT_EXPIRES_IN=1d

# Allowed frontend client origin for CORS requests
CLIENT_URL=http://localhost:5173
