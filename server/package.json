{
  "name": "ruralcare-connect-server",
  "version": "1.0.0",
  "private": true,
  "description": "RuralCare Connect - Express Backend API with PostgreSQL & Prisma",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx src/tests/securityVerification.ts",
    "test:fieldwork": "tsx src/tests/fieldworkWorkflowVerification.ts",
    "test:reliability": "tsx src/tests/offlineSyncReliabilityVerification.ts",
    "test:autosync": "tsx src/tests/autoSyncReliabilityVerification.ts",
    "test:emergency": "tsx src/tests/emergencySystemVerification.ts",
    "test:all": "tsx src/tests/securityVerification.ts && tsx src/tests/fieldworkWorkflowVerification.ts && tsx src/tests/offlineSyncReliabilityVerification.ts && tsx src/tests/autoSyncReliabilityVerification.ts && tsx src/tests/emergencySystemVerification.ts",
    "prisma:deploy": "prisma migrate deploy",
    "provision:account": "tsx src/scripts/provisionAccount.ts",
    "check:account": "tsx src/scripts/checkAccount.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "5.22.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
