# ==============================================================================
# RuralCare Connect - Client Environment Configuration Example
# ==============================================================================
# NOTE: Variables prefixed with 'VITE_' are bundled and publicly visible in browser code.
# NEVER place database passwords, private encryption keys, or secrets here.
# ==============================================================================

# Backend REST API endpoint URL
VITE_API_BASE_URL=http://localhost:5000/api

# Client application display title
VITE_APP_NAME=RuralCare Connect

# Deployment mode
VITE_DEMO_MODE=false
